rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  function signed() { return request.auth != null; }
  // Admin = has an admins/{uid} marker in Firestore (Firebase may ask you to allow this cross-service access when you publish).
  function admin() { return signed() && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)); }

  match /charity_posts/{userId}/{fileName} {
   allow read: if signed();
   allow create, update: if admin() && request.auth.uid == userId && request.resource.size < 10 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
   allow delete: if admin();
  }
  // Best-shot preview photo (admins)
  match /best_shot_photos/{userId}/{fileName} {
   allow read: if signed();
   allow create, update: if admin() && request.auth.uid == userId && request.resource.size < 10 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
   allow delete: if admin();
  }
  // Best-shot video (admins, max 25 MB; the app also enforces 3 seconds)
  match /best_shot/{userId}/{fileName} {
   allow read: if signed();
   allow create, update: if admin() && request.auth.uid == userId && request.resource.size < 25 * 1024 * 1024 && request.resource.contentType.matches('video/.*');
   allow delete: if admin();
  }
  match /avatars/{userId}/{fileName} {
   allow read: if signed();
   allow create, update: if signed() && request.auth.uid == userId && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
   allow delete: if signed() && (request.auth.uid == userId || admin());
  }
 }
}
